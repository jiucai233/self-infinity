# Self-Infinity backend settings (plan section 9.1). Copy to .env and fill in what you use.
# An empty value means "use the default" (shown in brackets).

# deepseek / openai / kimi / gemini / claude / mock. Empty: the first provider that has a key, else mock.
LLM_PROVIDER=
# Default model for the selected provider. Empty: the provider's own default model.
LLM_MODEL=
# Model per sub-agent, as JSON, e.g. {"clarifier": "<small model>", "auditor": "<strongest model>"}.
# Sub-agents: clarifier, syllabus_finder, planner, auditor, challenger, recorder, linker, narrator,
# recommender, checkin_converter, material_finder.
LLM_MODEL_OVERRIDES=
# One of the Auditor's three verdict votes from another model family (deepseek / gemini / claude /
# openai), on AUDITOR_SECOND_MODEL [that provider's own default]. Empty: all votes on the Auditor's model.
AUDITOR_SECOND_PROVIDER=
AUDITOR_SECOND_MODEL=

DEEPSEEK_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
KIMI_API_KEY=
# Claude: with the key set, an account can choose it for its agents (PUT /api/llm). [claude-haiku-5-5]
ANTHROPIC_API_KEY=
CLAUDE_MODEL=
# Voice (speech to text, text to speech) always goes through OpenAI and is on whenever
# OPENAI_API_KEY is set; without it the app uses the browser's or the phone's own speech.
# [gpt-transcribe] / [gpt-4o-mini-tts] / [marin]
TRANSCRIBE_MODEL=
SPEECH_MODEL=
SPEECH_VOICE=
# Live voice (WebRTC). The Guide and the audits talk on GPT-Live [gpt-live-1]; where a Live
# session cannot be opened the Guide uses [gpt-realtime-2.1] and audits [gpt-live-transcribe].
# GUIDE_VOICE [live] or realtime, AUDIT_VOICE [live] or turns: which one each opens first.
LIVE_MODEL=
REALTIME_MODEL=
LIVE_TRANSCRIBE_MODEL=
GUIDE_VOICE=
AUDIT_VOICE=
# Empty: offline mock search.
TAVILY_API_KEY=

# [sqlite:///./self_infinity.db] In production: Supabase → Connect → Transaction pooler (port 6543),
# e.g. postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Accounts (docs/deploy.md). [dev] = no sign-in, one local user. supabase = every request needs a
# Supabase access token; each account's data lives in its own schema.
AUTH_MODE=
# https://<ref>.supabase.co — its JWKS verifies the tokens.
SUPABASE_URL=
# Only for older projects that still sign tokens with the HS256 "JWT Secret".
SUPABASE_JWT_SECRET=
# Display time zone and the calendar-date boundary for daily check-ins. [Asia/Seoul]
APP_TIMEZONE=

# Safety valves on audit length, not quotas the model is told about. Night mode doubles them. [8] [4]
AUDIT_MAX_TURNS=
TASK_MAX_TURNS=
# Second examiner for passes; turn off to measure the Auditor alone. [true]
CHALLENGER_ENABLED=
# How many recent misconceptions the Challenger sees. [5]
CHALLENGER_MISCONCEPTION_LIMIT=
# Seconds. [30] [15]
LLM_TIMEOUT_SECONDS=
SEARCH_TIMEOUT_SECONDS=
